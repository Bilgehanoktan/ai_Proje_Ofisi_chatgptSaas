{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aicos:a0:v95:contract:GrantDecision:0.1.0",
  "title": "GrantDecision",
  "type": "object",
  "properties": {
    "grant_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_revision": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "company_id": {
      "type": "string",
      "minLength": 1
    },
    "effect_scope_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "lease_id": {
      "type": "string",
      "minLength": 1
    },
    "witness_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "decision": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "grant_id",
    "policy_revision",
    "tenant_id",
    "company_id",
    "effect_scope_digest",
    "lease_id",
    "witness_epoch",
    "decision"
  ],
  "additionalProperties": false
}