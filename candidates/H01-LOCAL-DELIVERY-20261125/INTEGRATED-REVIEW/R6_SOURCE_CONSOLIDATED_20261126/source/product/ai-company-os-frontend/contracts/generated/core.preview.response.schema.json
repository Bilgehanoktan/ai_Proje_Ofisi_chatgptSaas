{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-company-os:d0:core-preview-response:0",
  "type": "object",
  "required": [
    "sample",
    "plan_preview",
    "event_preview"
  ],
  "additionalProperties": false,
  "properties": {
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "data_status",
        "layout",
        "plan",
        "events",
        "authority"
      ],
      "properties": {
        "schema_version": {
          "const": "core.preview.v0-D0"
        },
        "data_status": {
          "const": "D0_SAMPLE_NO_RUNTIME"
        },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "revision",
            "width",
            "height",
            "floors"
          ],
          "properties": {
            "revision": {
              "const": "layout-d3-demo"
            },
            "width": {
              "const": 6
            },
            "height": {
              "const": 6
            },
            "floors": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "name",
                  "rooms",
                  "stations",
                  "walkable"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "rooms": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "label",
                        "x",
                        "y",
                        "w",
                        "h",
                        "color"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "x": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 5
                        },
                        "y": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 5
                        },
                        "w": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 6
                        },
                        "h": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 6
                        },
                        "color": {
                          "type": "string",
                          "pattern": "^#[0-9a-fA-F]{6}$"
                        }
                      }
                    }
                  },
                  "stations": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "role",
                        "room",
                        "x",
                        "y",
                        "agent_instance_id"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "role": {
                          "enum": [
                            "orchestrator",
                            "research",
                            "engineer",
                            "qa"
                          ]
                        },
                        "room": {
                          "type": "string",
                          "minLength": 1
                        },
                        "x": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 5
                        },
                        "y": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 5
                        },
                        "agent_instance_id": {
                          "type": "null"
                        }
                      }
                    }
                  },
                  "walkable": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 5
                        },
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 5
                        }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "uniqueItems": true
                  }
                }
              },
              "minItems": 1
            }
          }
        },
        "plan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "worktype",
            "tasks"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "worktype": {
              "const": "RESEARCH"
            },
            "tasks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "label",
                  "role",
                  "depends_on"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "role": {
                    "enum": [
                      "orchestrator",
                      "research",
                      "engineer",
                      "qa",
                      "independent-verifier",
                      "human-authority"
                    ]
                  },
                  "depends_on": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  }
                }
              },
              "minItems": 1
            }
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_id",
              "seq",
              "kind",
              "floor_id",
              "station_id",
              "tenant_id",
              "world_id",
              "environment_id",
              "stream_id",
              "layout_revision"
            ],
            "properties": {
              "event_id": {
                "type": "string",
                "minLength": 1
              },
              "seq": {
                "type": "integer",
                "minimum": 1
              },
              "kind": {
                "enum": [
                  "DEMO_FLOOR_SELECTED",
                  "DEMO_STATION_SELECTED"
                ]
              },
              "floor_id": {
                "type": "string",
                "minLength": 1
              },
              "station_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "tenant_id": {
                "const": "synthetic-tenant"
              },
              "world_id": {
                "const": "demo-world"
              },
              "environment_id": {
                "const": "A0_SAMPLE_ONLY"
              },
              "stream_id": {
                "const": "demo-ui-stream"
              },
              "layout_revision": {
                "const": "layout-d3-demo"
              }
            }
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "effective",
            "decision",
            "reason_codes",
            "real_test",
            "release_ready"
          ],
          "properties": {
            "effective": {
              "const": false
            },
            "decision": {
              "const": "DENY"
            },
            "reason_codes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "real_test": {
              "const": "NOT_RUN"
            },
            "release_ready": {
              "const": false
            }
          }
        }
      }
    },
    "plan_preview": {
      "type": "object",
      "required": [
        "plan_id",
        "mode",
        "waves",
        "tasks",
        "admission",
        "reasons",
        "dispatch_allowed",
        "real_run_count",
        "release_ready"
      ],
      "additionalProperties": false,
      "properties": {
        "plan_id": {
          "type": "string"
        },
        "mode": {
          "const": "D0_PLAN_PREVIEW"
        },
        "waves": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "role",
              "state",
              "run_id"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "state": {
                "const": "HOLD"
              },
              "run_id": {
                "type": "null"
              }
            }
          }
        },
        "admission": {
          "const": "DENY"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dispatch_allowed": {
          "const": false
        },
        "real_run_count": {
          "type": "null"
        },
        "release_ready": {
          "const": false
        }
      }
    },
    "event_preview": {
      "type": "object",
      "required": [
        "mode",
        "freshness",
        "last_seq",
        "selected_floor",
        "selected_station",
        "results",
        "persistent",
        "verified"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "D0_REPLAY_PREVIEW"
        },
        "freshness": {
          "enum": [
            "SAMPLE",
            "RESYNC_REQUIRED"
          ]
        },
        "last_seq": {
          "type": "integer",
          "minimum": 0
        },
        "selected_floor": {
          "type": [
            "string",
            "null"
          ]
        },
        "selected_station": {
          "type": [
            "string",
            "null"
          ]
        },
        "results": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "persistent": {
          "const": false
        },
        "verified": {
          "const": false
        }
      }
    }
  }
}
