{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aicos:doc-spec-0099:C3-StateMutation:0.1.0-a0",
  "title": "A0 unratified candidate — C3-StateMutation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mutation_id",
    "t1_transaction_id",
    "aggregate_id",
    "expected_version",
    "new_version",
    "before_sha256",
    "after_sha256",
    "outbox_event_id",
    "scope",
    "mutation_class",
    "idempotency_key",
    "local_tx_requirement",
    "authority_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "0.1.0-a0"
      ]
    },
    "mutation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "t1_transaction_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "aggregate_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "expected_version": {
      "type": "integer",
      "minimum": 0
    },
    "new_version": {
      "type": "integer",
      "minimum": 1
    },
    "before_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "after_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "outbox_event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "environment_id",
        "effect_class"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "company_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "environment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "effect_class": {
          "type": "string",
          "enum": [
            "A0",
            "A1",
            "A2",
            "A3"
          ]
        },
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "mutation_class": {
      "type": "string",
      "enum": [
        "AGGREGATE_STATE",
        "BUDGET_RESERVATION",
        "RUN_ADMISSION"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "local_tx_requirement": {
      "type": "string",
      "enum": [
        "T1_SAME_ACID_COMMIT"
      ]
    },
    "authority_status": {
      "type": "string",
      "enum": [
        "A0_CANDIDATE_HOLD"
      ]
    }
  }
}