{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aicos:a0:v95:contract:ArtifactVersion:0.1.0",
  "title": "ArtifactVersion",
  "type": "object",
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "canonical_revision": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "worktype_version": {
      "type": "string",
      "minLength": 1
    },
    "release_revision": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "artifact_id",
    "sha256",
    "canonical_revision",
    "source_revision",
    "worktype_version",
    "release_revision"
  ],
  "additionalProperties": false
}