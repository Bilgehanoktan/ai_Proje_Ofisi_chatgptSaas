{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "D0 MVP diagnostics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "plan_digest",
    "admission",
    "dispatch_allowed",
    "release_ready",
    "provider_called",
    "spend_allowed",
    "independent_accepted",
    "real_run_count",
    "sections",
    "sample_event_rows",
    "diagnostic_remaining_minor",
    "actual_cost_minor",
    "revenue_minor"
  ],
  "properties": {
    "schema_version": {
      "const": "mvp.diagnostics.v1-D0"
    },
    "mode": {
      "const": "SYNTHETIC_LOCAL_ONLY"
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "admission": {
      "const": "DENY"
    },
    "dispatch_allowed": {
      "const": false
    },
    "release_ready": {
      "const": false
    },
    "provider_called": {
      "const": false
    },
    "spend_allowed": {
      "const": false
    },
    "independent_accepted": {
      "const": false
    },
    "real_run_count": {
      "type": "null"
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orchestrator",
        "runtime",
        "event_store",
        "model",
        "gateway",
        "tools",
        "verifier",
        "finance"
      ],
      "properties": {
        "orchestrator": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
        },
        "runtime": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
        },
        "event_store": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
        },
        "model": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
        },
        "gateway": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
        },
        "tools": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
        },
        "verifier": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
        },
        "finance": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
        }
      }
    },
    "sample_event_rows": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "diagnostic_remaining_minor": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "actual_cost_minor": {
      "type": "null"
    },
    "revenue_minor": {
      "type": "null"
    }
  }
}
