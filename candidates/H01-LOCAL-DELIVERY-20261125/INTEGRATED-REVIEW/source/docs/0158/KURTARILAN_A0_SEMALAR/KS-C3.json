{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aicos:a0:v95:contract:EvidenceReceipt:0.1.0",
  "title": "EvidenceReceipt",
  "type": "object",
  "properties": {
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "issuer_principal_id": {
      "type": "string",
      "minLength": 1
    },
    "trust_domain": {
      "type": "string",
      "minLength": 1
    },
    "subject_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "signature_ref": {
      "type": "string",
      "minLength": 1
    },
    "evidence_kind": {
      "type": "string",
      "minLength": 1
    },
    "valid_until_utc": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "receipt_id",
    "issuer_principal_id",
    "trust_domain",
    "subject_digest",
    "signature_ref",
    "evidence_kind",
    "valid_until_utc"
  ],
  "additionalProperties": false
}