+from typing import NoReturn
+import os
+from pathlib import Path
+import sqlite3
+
+
+def _digest(value):
+    return type(value) is str and len(value) == 64 and all(c in '0123456789abcdef' for c in value)
+
+
+@dataclass(frozen=True)
+class RootPin:
+    record_sha: str
+    key_sha: str
+    recovery_epoch: int
+
+    def validate(self):
+        if not (_digest(self.record_sha) and _digest(self.key_sha) and
+                type(self.recovery_epoch) is int and 0 < self.recovery_epoch < 2**63):
+            raise ValueError('D0_AUTHORITY_PIN_HOLD')
+
+
+def _path(path):
+    p = Path(os.path.abspath(path))
+    if not p.name.endswith('.authority.sqlite') or p.resolve() != p or any(x.is_symlink() for x in (p, *p.parents)):
+        raise ValueError('D0_AUTHORITY_PATH_HOLD')
+    return p
+
+
+class D0IntentAuthority:
+    """Fixture: never restore alongside product DBs. All publishers must use CAS."""
+    def __init__(self, path):
+        self.path = _path(path)
+
+    def _db(self):
+        db = sqlite3.connect(self.path.as_uri() + '?mode=rw', uri=True, isolation_level=None, timeout=2)
+        db.execute('PRAGMA trusted_schema=OFF')
+        return db
+
+    @classmethod
+    def create(cls, path, root, *, iam_bootstrap=False):
+        if type(root) is not RootPin or type(iam_bootstrap) is not bool:
+            raise ValueError('D0_AUTHORITY_PIN_HOLD')
+        root.validate()
+        a = cls(path)
+        fd = os.open(a.path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
+        os.close(fd)
+        with closing(a._db()) as db:
+            db.executescript("""BEGIN IMMEDIATE;
+            CREATE TABLE roots(seq INTEGER PRIMARY KEY, record_sha TEXT UNIQUE NOT NULL,
+                key_sha TEXT NOT NULL, epoch INTEGER NOT NULL);
+            CREATE TABLE claims(scope_sha TEXT PRIMARY KEY, binding TEXT UNIQUE NOT NULL,
+                tx TEXT UNIQUE NOT NULL, request_digest TEXT NOT NULL, root_seq INTEGER NOT NULL,
+                root_sha TEXT NOT NULL);
+            CREATE TRIGGER roots_no_update BEFORE UPDATE ON roots BEGIN SELECT RAISE(ABORT,'append only'); END;
+            CREATE TRIGGER roots_no_delete BEFORE DELETE ON roots BEGIN SELECT RAISE(ABORT,'append only'); END;
+            CREATE TRIGGER roots_no_replace BEFORE INSERT ON roots WHEN EXISTS(SELECT 1 FROM roots WHERE seq=NEW.seq OR record_sha=NEW.record_sha) BEGIN SELECT RAISE(ABORT,'append only'); END;
+            CREATE TRIGGER claims_no_update BEFORE UPDATE ON claims BEGIN SELECT RAISE(ABORT,'append only'); END;
+            CREATE TRIGGER claims_no_delete BEFORE DELETE ON claims BEGIN SELECT RAISE(ABORT,'append only'); END;
+            CREATE TRIGGER claims_no_replace BEFORE INSERT ON claims WHEN EXISTS(SELECT 1 FROM claims WHERE scope_sha=NEW.scope_sha OR binding=NEW.binding OR tx=NEW.tx) BEGIN SELECT RAISE(ABORT,'append only'); END;""")
+            db.execute('INSERT INTO roots VALUES (1,?,?,?)', (root.record_sha, root.key_sha, root.recovery_epoch))
+            if iam_bootstrap:
+                db.execute('CREATE TABLE iam_bootstrap(id INTEGER PRIMARY KEY CHECK(id=1))')
+                db.execute('INSERT INTO iam_bootstrap VALUES (1)')
+            db.execute('COMMIT')
+        return a
+
+    @staticmethod
+    def _head(db):
+        row = db.execute('SELECT seq,record_sha,key_sha,epoch FROM roots ORDER BY seq DESC LIMIT 1').fetchone()
+        if row is None:
+            raise ValueError('D0_AUTHORITY_MISSING_HOLD')
+        seq, *data = row
+        root = RootPin(*data)
+        root.validate()
+        return seq, root
+
+    @staticmethod
+    def _iam_mode(db):
+        # Partial schema also fails closed. Original authority stores are unaffected.
+        return db.execute("SELECT 1 FROM sqlite_master WHERE name GLOB 'iam_*' LIMIT 1").fetchone() is not None
+
+    def _check_iam(self, db, session_check):
+        if not self._iam_mode(db):
+            if session_check is not None:
+                raise ValueError('D0_IAM_MODE_HOLD')
+            return None
+        from app.core.iam_session import SessionClaimCheck
+        if type(session_check) is not SessionClaimCheck:
+            raise ValueError('D0_IAM_CHECK_REQUIRED_HOLD')
+        return session_check.inspect(self,db)
+
+    def publish(self, expected, new):
+        if type(expected) is not RootPin or type(new) is not RootPin:
+            raise ValueError('D0_AUTHORITY_PIN_HOLD')
+        expected.validate()
+        new.validate()
+        with closing(self._db()) as db:
+            db.execute('BEGIN IMMEDIATE')
+            seq, current = self._head(db)
+            if self._iam_mode(db):
+                raise ValueError('D0_JOINT_PUBLICATION_HOLD')
+            if current != expected or new.key_sha != current.key_sha or new.recovery_epoch < current.recovery_epoch or new.record_sha == current.record_sha:
+                raise ValueError('D0_AUTHORITY_CAS_HOLD')
+            db.execute('INSERT INTO roots VALUES (?,?,?,?)', (seq+1, new.record_sha, new.key_sha, new.recovery_epoch))
+            db.execute('COMMIT')
+
+    @contextmanager
+    def claim_and_fence(self, expected, scope_sha, binding, tx, request_digest, *, session_check=None):
+        """Consume scope before T1; then lock the root through the caller's commit.
+
+        Any failure after claim leaves a permanent quarantine. No reset or retry.
+        A publisher winning the gap between claim commit and fence causes HOLD.
+        """
+        if type(expected) is not RootPin or not all(_digest(x) for x in (scope_sha,binding,request_digest)) or type(tx) is not str or not 0 < len(tx) <= 512:
+            raise ValueError('D0_AUTHORITY_INPUT_HOLD')
+        expected.validate()
+        with closing(self._db()) as db:
+            db.execute('BEGIN IMMEDIATE')
+            seq, current = self._head(db)
+            if current != expected:
+                raise ValueError('D0_AUTHORITY_ROOT_HOLD')
+            session_sha = self._check_iam(db,session_check)
+            if db.execute('SELECT 1 FROM claims WHERE scope_sha=? OR binding=? OR tx=?', (scope_sha,binding,tx)).fetchone():
+                raise ValueError('D0_AUTHORITY_ALREADY_CLAIMED_HOLD')
+            db.execute('INSERT INTO claims VALUES (?,?,?,?,?,?)', (scope_sha,binding,tx,request_digest,seq,current.record_sha))
+            if session_sha is not None:
+                db.execute('INSERT INTO iam_claim_pins VALUES (?,?)',(scope_sha,session_sha))
+            db.execute('COMMIT')
+            db.execute('BEGIN IMMEDIATE')
+            if self._head(db) != (seq, expected):
+                raise ValueError('D0_AUTHORITY_ROOT_CHANGED_HOLD')
+            if self._check_iam(db,session_check) != session_sha:
+                raise ValueError('D0_IAM_CLAIM_DRIFT_HOLD')
+            try:
+                yield
+            finally:
+                if db.in_transaction:
+                    db.execute('ROLLBACK')
+
+
+def execute_authority_fenced_transition(*, authority, intent, context, registry, witness,
+        expected_binding, memory_path, reader, public_key, raw, journal, connect, clock,
+        company=None, expected_company_binding=None, result=None, result_reader=None,
+        session_check=None, protected_org=None):
+    """D0 legacy fixture or explicit protected G5 entry; no live grant."""
+    # Two reference types are not interchangeable; never fall back to legacy.
+    if protected_org is not None and session_check is not None:
+        raise PermissionError('D5C_R8_DUAL_REFERENCE_HOLD')
+    if protected_org is not None:
+        from app.core.transaction.org_membership_review import require_protected_org_commit
+        require_protected_org_commit(authority, intent, protected_org)
+        raise PermissionError('D5C_R8_PROTECTED_EXECUTION_UNIMPLEMENTED_HOLD')
+    from app.core.transaction.fenced_transition import (execute_fenced_transition, intent_pin,
+        resolve_fence_binding, resolve_result_binding, check_result_store_separation)
+    from app.core.transaction.witnessed_mapping import binding_digest
+    from app.core.agent_runtime.memory_witness import LatestWitnessPin
+    if type(authority) is not D0IntentAuthority or type(witness) is not LatestWitnessPin:
+        raise ValueError('D0_AUTHORITY_ADAPTER_HOLD')
+    if binding_digest(intent, context, registry, witness) != expected_binding:
+        raise ValueError('D0_AUTHORITY_BINDING_HOLD')
+    if any(os.path.samefile(authority.path, p) for p in (memory_path, reader.path, journal.path)):
+        raise ValueError('D0_AUTHORITY_SEPARATION_HOLD')
+    company_pin = resolve_fence_binding(intent, expected_binding, company, expected_company_binding)
+    check_result_store_separation(result_reader,(authority.path,memory_path,reader.path,journal.path))
+    fence_binding = resolve_result_binding(intent,context,registry,witness,expected_binding,company,
+                                          company_pin,result,result_reader,clock() if result is not None else None,raw)
+    pin = intent_pin(intent, fence_binding)
+    # D0 only: bind the server-owned session identity to the exact T1 intent.
+    # This is not an ORG grant, independent issuer, or production authorization.
+    if session_check is not None:
+        from app.core.iam_session import SessionClaimCheck, D0_SCOPE
+        from app.core.agent_runtime.lifecycle import Scope
+        scope = getattr(intent, 'scope', None)
+        if (type(session_check) is not SessionClaimCheck or type(scope) is not Scope
+                or session_check.scope != D0_SCOPE
+                or (scope.tenant_id, scope.company_id, scope.environment_id) != D0_SCOPE
+                or scope.principal_id != session_check.principal
+                or scope.agent_instance_id != session_check.agent):
+            raise ValueError('D0_AUTHORITY_SESSION_SCOPE_HOLD')
+    root = RootPin(witness.record_sha, witness.key_sha, witness.recovery_epoch)
+    with authority.claim_and_fence(root, pin.scope_sha, pin.binding, pin.transaction_ref,
+                                   pin.request_digest, session_check=session_check):
+        return execute_fenced_transition(intent, context, registry, witness, expected_binding,
+            memory_path, reader, public_key, raw, journal, connect, clock, lambda: witness,
+            company=company, expected_company_binding=expected_company_binding,
+            result=result, result_reader=result_reader)
+
+def execute_protected_authority_fenced_transition(*, authority, intent, context, registry, witness,
+        expected_binding, memory_path, reader, public_key, raw, journal, connect, clock,
+        company=None, expected_company_binding=None, result=None, result_reader=None,
+        session_check=None, protected_org=None) -> NoReturn:
+    """Protected D0 entry; deny before claim, journal stage, or connection access.
+
+    The R7 transport gate is shared, not a caller-selected mode or a grant.
+    No protected composition is implemented yet. Never fall back to the legacy
+    diagnostic wrapper, even if the capability gate unexpectedly returns.
+    """
+    from app.core.transaction.postgres_session import require_strict_postgres_commit
+    require_strict_postgres_commit()
+    raise PermissionError('T1_PROTECTED_AUTHORITY_COMPOSITION_UNIMPLEMENTED_HOLD')
