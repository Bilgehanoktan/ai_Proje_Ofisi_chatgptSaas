+def _minimum_transition_count(start, target):
+    """Lower bound from the existing D0 lifecycle graph, not history proof."""
+    frontier = {start}
+    seen = set()
+    distance = 0
+    while frontier:
+        if target in frontier:
+            return distance
+        seen.update(frontier)
+        frontier = {n for state in frontier for n in EDGES.get(state, ())} - seen
+        distance += 1
+    return None
